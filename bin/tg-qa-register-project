#!/usr/bin/env python3
"""Register a project in tg-qa.

Usage:
  tg-qa-register-project <alias> --bot @my_bot --api-id 123 --api-hash abc \
      [--path <abs>] [--session main] [--role name=session ...]
  tg-qa-register-project <alias> --remove

The registry entry keeps everything that must never enter the project repo:
api_id/api_hash and role→session mapping. A session ref is either a bare name
(resolved in ~/.config/tg-qa/sessions/) or a path to an EXISTING .session file —
bring-your-own-session is supported, bin/tg-qa-login creates fresh ones.

Also scaffolds <project_path>/.tg-qa/ with a NON-secret config.json skeleton.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "runners"))
from registry import registry_write_path, sessions_dir  # noqa: E402

REGISTRY = registry_write_path()


def load() -> list[dict]:
    if not REGISTRY.exists():
        return []
    try:
        return json.loads(REGISTRY.read_text())
    except json.JSONDecodeError:
        return []


def save(entries: list[dict]) -> None:
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    REGISTRY.write_text(json.dumps(entries, ensure_ascii=False, indent=2))


# Scaffolded config.json: PROJECT-level, non-secret keys only (null = unset).
# api_id/api_hash/sessions stay in the registry — committing config.json must
# never leak credentials or machine paths into the project repo.
CONFIG_SKELETON = {
    "bot": None,               # @username of the bot under test (duplicated here for the repo's sake)
    "bot_source_dir": None,    # path to the bot's source code — bot_mine reads handlers from it
    "bot_framework": None,     # node-telegram-bot-api | aiogram | grammy | telegraf (auto-detected when null)
    "language": None,          # language for generated scenarios (default: language of the task)
    "reply_timeout": None,     # seconds to wait for a bot reply (default 10)
    "send_delay": None,        # min seconds between outgoing actions (default 1.0; FloodWait guard)
    "text_masks": None,        # regex list masked out of reply snapshots (dates, ids, balances)
    "fixture_cmd": None,       # shell cmd seeding deterministic data before a run
    "fixture_teardown_cmd": None,
    "context_notes": None,     # free-form notes for generation agents
    "miniapp_url": None,       # Mini App URL for the web-qa bridge (v0.2)
}


def init_project_dir(project_path: Path, alias: str) -> None:
    tg_qa = project_path / ".tg-qa"
    tg_qa.mkdir(parents=True, exist_ok=True)
    for sub in ("scenarios", "specs", "baseline", "reports"):
        (tg_qa / sub).mkdir(exist_ok=True)
    cfg_file = tg_qa / "config.json"
    if not cfg_file.exists():
        cfg_file.write_text(json.dumps(CONFIG_SKELETON, ensure_ascii=False, indent=2) + "\n")
    ctx_file = tg_qa / "bot.context.md"
    if not ctx_file.exists():
        ctx_file.write_text(
            f"# {alias} — Bot Context\n\n"
            "<i>Generated by bot_mine + exploration.</i>\n\n"
            "## Commands\n_(empty)_\n\n## Menus & Buttons\n_(empty)_\n\n"
            "## Flows / FSM States\n_(empty)_\n\n## Roles\n_(empty)_\n\n"
            "## Scope\n_(empty)_\n\n## Out of Scope\n_(empty)_\n"
        )
    gitignore = tg_qa / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text("# tg-qa runtime artifacts (keep bot.context.md, scenarios/, specs/, baseline/ in git)\n"
                             "reports/\n"
                             "*.tmp\n")


def parse_roles(pairs: list[str], default_session: str | None) -> list[dict]:
    roles: list[dict] = []
    for p in pairs or []:
        if "=" not in p:
            print(f"--role expects name=session_ref, got '{p}'", file=sys.stderr)
            raise SystemExit(64)
        name, session = p.split("=", 1)
        roles.append({"name": name, "session": session})
    if not roles:
        roles = [{"name": "default", "session": default_session or "main"}]
    roles[0]["default"] = True
    return roles


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("alias")
    ap.add_argument("--bot", help="@username of the bot under test")
    ap.add_argument("--api-id", type=int, help="api_id from https://my.telegram.org")
    ap.add_argument("--api-hash", help="api_hash from https://my.telegram.org")
    ap.add_argument("--path", default=os.getcwd(), help="Absolute project path (default: cwd)")
    ap.add_argument("--session", help="default role's session: name in %s or path to existing .session"
                                      % sessions_dir())
    ap.add_argument("--role", action="append",
                    help="extra role as name=session_ref (repeatable); first role is the default")
    ap.add_argument("--remove", action="store_true", help="Remove this alias from registry")
    args = ap.parse_args()

    entries = load()

    if args.remove:
        new_entries = [e for e in entries if e.get("alias") != args.alias]
        save(new_entries)
        print(json.dumps({"removed": args.alias, "remaining": len(new_entries)}, ensure_ascii=False))
        return 0

    if not args.bot:
        print("--bot is required (unless --remove).", file=sys.stderr)
        return 64

    abs_path = os.path.abspath(args.path)
    record = {
        "alias": args.alias,
        "path": abs_path,
        "bot": args.bot if args.bot.startswith("@") else "@" + args.bot,
        "api_id": args.api_id,
        "api_hash": args.api_hash,
        "roles": parse_roles(args.role or [], args.session),
    }

    handled = False
    out: list[dict] = []
    for e in entries:
        if e.get("alias") == args.alias or (e.get("path") == abs_path and abs_path):
            out.append(record)
            handled = True
        else:
            out.append(e)
    if not handled:
        out.append(record)

    save(out)
    init_project_dir(Path(abs_path), args.alias)

    print(json.dumps({
        "registered": args.alias,
        "path": abs_path,
        "bot": record["bot"],
        "roles": [r["name"] for r in record["roles"]],
        "tg_qa_dir": str(Path(abs_path) / ".tg-qa"),
        "hint": "create sessions with bin/tg-qa-login, or drop existing .session files "
                f"into {sessions_dir()} (or reference them by path in roles[].session)",
    }, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
